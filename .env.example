BROKERAGE_BASE_URL=https://brokerage.example
BROKERAGE_TOKEN_PATH=/oauth2/token
BROKERAGE_ORDER_PATH=/v1/orders
BROKERAGE_ORDER_STATUS_PATH=/v1/orders/{orderId}
BROKERAGE_TIMEOUT_MS=5000
BROKERAGE_APP_KEY=demo-app-key
BROKERAGE_APP_SECRET=demo-app-secret
BROKERAGE_CLIENT_ID=assignment-client

